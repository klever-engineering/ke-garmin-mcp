# Garmin Connect credentials (required for first login and token refresh fallback)
GARMIN_USERNAME=your_garmin_username
GARMIN_PASSWORD=your_garmin_password

# Optional: token directory (garmin_tokens.json). Default shown: an owner-only
# folder on the home filesystem; $XDG_CONFIG_HOME replaces ~/.config when set.
# Relative paths resolve from the workspace root. Keep it on a filesystem that
# honours Unix permissions (not NTFS/FAT).
# GARMIN_TOKENS_DIR=~/.config/lifeos/garmin-mcp/tokens

# Optional: per-client bearer tokens for the HTTP transport (ADR 0007), as
# name=token pairs separated by commas. Each token is at least 32 characters,
# for example from `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# When set, requests without a matching `Authorization: Bearer` token get 401.
# GARMIN_MCP_CLIENT_TOKENS=life-daily-report=<token>,lifeos-sessions=<token>
# Optional: `observe` accepts requests without a valid token and logs them.
# GARMIN_MCP_AUTH=enforce

# Optional: max date range accepted by range-based CLI/MCP tools
GARMIN_MAX_RANGE_DAYS=93

# Optional: explicit env file path (use env var when absolute path is needed)
# GARMIN_ENV_FILE=/path/to/.env

